        "js": "(function(){var s=7;Math.random=function(){s=s*16807%2147483647;return(s-1)/2147483646};var c=document.getElementById('gameCanvas'),n=0;function sc(){return parseInt(document.getElementById('scoreVal').textContent,10)||0}function over(){return !!document.getElementById('retryBtn').offsetParent}function drop(dx){var r=c.getBoundingClientRect(),x=r.left+r.width/2+dx*r.width/400,y=r.bottom-4,o={clientX:x,clientY:y,bubbles:true,pointerId:1,isPrimary:true};c.dispatchEvent(new PointerEvent('pointerdown',o));window.dispatchEvent(new PointerEvent('pointerup',o))}var o=[0,0,0];function t(){if(over())return;if(sc()>=n){if(n>=o.length)return;drop(o[n]);n++}setTimeout(t,300)}document.getElementById('startBtn').click();setTimeout(t,1200)})();"
